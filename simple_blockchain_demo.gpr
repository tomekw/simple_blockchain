with "config/simple_blockchain_demo_config.gpr";
project Simple_Blockchain_Demo is

   for Source_Dirs use ("src/", "config/");
   for Object_Dir use "obj/" & Simple_Blockchain_Demo_Config.Build_Profile;
   for Create_Missing_Dirs use "True";
   for Exec_Dir use "bin";
   for Main use ("simple_blockchain_demo.adb");

   package Compiler is
      for Default_Switches ("Ada") use Simple_Blockchain_Demo_Config.Ada_Compiler_Switches;
   end Compiler;

   package Binder is
      for Switches ("Ada") use ("-Es"); --  Symbolic traceback
   end Binder;

   package Install is
      for Artifacts (".") use ("share");
   end Install;

end Simple_Blockchain_Demo;
